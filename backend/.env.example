HOST=127.0.0.1
PORT=3000
WORKSPACE_ROOT=./workspace
DATA_DIR=./data
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Optional public HTTPS URL, for example https://agent.example.com
PUBLIC_URL=
# Extra trusted hosts/origins, separated by commas. Do not use wildcards.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# Use true for a browser frontend served over HTTPS; false for the local client.
COOKIE_SECURE=false
